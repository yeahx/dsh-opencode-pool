{
  "name": "dsh-opencode-pool",
  "version": "1.2.1",
  "description": "OpenCode Go API key pool for DeepSeek Harness: sticky-key failover on quota/auth errors plus official 5h/week/month usage in Settings",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cli.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "api-key",
    "key-pool",
    "quota",
    "failover",
    "prompt-cache"
  ],
  "author": "lazydog (yeahx) <11347901+yeahx@users.noreply.github.com> (https://github.com/yeahx)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeahx/dsh-opencode-pool.git"
  },
  "homepage": "https://github.com/yeahx/dsh-opencode-pool#readme",
  "bugs": {
    "url": "https://github.com/yeahx/dsh-opencode-pool/issues"
  }
}
